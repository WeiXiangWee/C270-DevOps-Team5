<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">

    <%- include('partials/navbarSimple') %>

    <div class="container py-5" style="min-height: 70vh;">
        <a href="/dashboard" class="text-decoration-none fw-semibold mb-3 d-inline-block" style="color:#2d7a2d;">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>

        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <h2 class="fw-bold mb-0">
                <%= session.user.role === 'admin' ? 'All Bookings' : 'My Bookings' %>
            </h2>
        </div>

        <% if (bookings.length === 0) { %>
        <div class="text-center py-5">
            <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
            <p class="text-muted">No bookings found!</p>
        </div>
        <% } else { %>
        <div class="card border-0 shadow-sm rounded-4">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background-color:#f0f7f0;">
                        <tr>
                            <th class="p-3">Booking ID</th>
                            <th class="p-3">Facility</th>
                            <% if (session.user.role === 'admin') { %>
                            <th class="p-3">Booked By</th>
                            <% } %>
                            <th class="p-3">Date</th>
                            <th class="p-3">Time Slot</th>
                            <th class="p-3">Status</th>
                            <th class="p-3">Remarks</th>
                            <% if (session.user.role === 'admin') { %>
                            <th class="p-3">Actions</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(booking => { %>
                        <tr class="<%= booking.status === 'cancelled' ? 'table-danger' : '' %>">
                            <td class="p-3 text-muted">#<%= booking.id %></td>
                            <td class="p-3 fw-semibold"><%= booking.name %></td>
                            <% if (session.user.role === 'admin') { %>
                            <td class="p-3"><%= booking.userName %></td>
                            <% } %>
                            <td class="p-3"><%= booking.date %></td>
                            <td class="p-3"><%= booking.duration %></td>
                            <td class="p-3">
                                <% if (booking.status === 'confirmed') { %>
                                <span class="badge rounded-pill py-2 px-3"
                                      style="background-color:#e8f5e8; color:#2d7a2d;">
                                    <i class="bi bi-check-circle me-1"></i>Confirmed
                                </span>
                                <% } else { %>
                                <span class="badge rounded-pill py-2 px-3 bg-danger text-white">
                                    <i class="bi bi-x-circle me-1"></i>Cancelled
                                </span>
                                <% } %>
                            </td>
                            <td class="p-3 text-muted">
                                <%= booking.remarks || '-' %>
                            </td>
                            <% if (session.user.role === 'admin') { %>
                            <td class="p-3">
                                <% if (booking.status !== 'cancelled') { %>
                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="showCancelModal(<%= booking.id %>)">
                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                </button>
                                <% } else { %>
                                <span class="text-muted small">Cancelled</span>
                                <% } %>
                            </td>
                            <% } %>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>
    </div>

    <!-- Cancel Booking Modal (Admin only) -->
    <% if (session.user.role === 'admin') { %>
    <div class="modal fade" id="cancelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Cancel Booking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Please provide a reason for cancellation:</p>
                    <form id="cancelForm" method="POST">
                        <div class="mb-3">
                            <textarea name="reason" class="form-control" rows="3"
                                      placeholder="Enter reason for cancellation..." required></textarea>
                        </div>
                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-danger fw-bold">
                                <i class="bi bi-x-circle me-1"></i>Confirm Cancel
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <footer class="py-4 text-white text-center" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        <% if (session.user.role !== 'admin' && showAlert) { %>
        window.onload = function() {
            alert('⚠️ <%= newCancellations %> of your booking(s) have been cancelled by the admin. Please check your bookings list to see which ones are affected.');
        };
        <% } %>

        function showCancelModal(bookingId) {
            const form = document.getElementById('cancelForm');
            form.action = '/bookings/cancel/' + bookingId;
            const modal = new bootstrap.Modal(document.getElementById('cancelModal'));
            modal.show();
        }
    </script>
</body>
</html>