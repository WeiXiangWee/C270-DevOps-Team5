<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="width:100%; max-width:420px;">

            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:60px;height:60px;background-color:#e8f5e8;">
                    <i class="bi bi-lock-fill fs-3" style="color:#2d7a2d;"></i>
                </div>
                <h4 class="fw-bold">Forgot Password?</h4>
                <p class="text-muted small">
                    Enter your RP email and we'll send 
                    you a verification code
                </p>
            </div>

            <% if (message) { %>
            <div class="alert alert-danger rounded-3">
                <i class="bi bi-exclamation-circle me-2"></i><%= message %>
            </div>
            <% } %>

            <form method="POST" action="/forgot-password">
                <div class="mb-3">
                    <label class="form-label fw-semibold">RP Email Address</label>
                    <input type="email" name="email" class="form-control rounded-3"
                           placeholder="12345678@myrp.edu.sg" required>
                </div>
                <button type="submit" class="btn w-100 fw-bold text-white rounded-3 py-2"
                        style="background-color:#2d7a2d;">
                    <i class="bi bi-send me-2"></i>Send Verification Code
                </button>
            </form>

            <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none fw-semibold" 
                   style="color:#2d7a2d;">
                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                </a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>