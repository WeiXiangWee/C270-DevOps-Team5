<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule Maintenance - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">

    <%- include('partials/navbarSimple') %>

    <div class="container py-5">
        <a href="/dashboard" class="text-decoration-none fw-semibold mb-3 d-inline-block" style="color:#2d7a2d;">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>

        <div class="row justify-content-center mt-3">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header text-white rounded-top-4" style="background-color:#1a4d2e;">
                        <h4 class="mb-0"><i class="bi bi-tools me-2"></i>Schedule Maintenance</h4>
                    </div>
                    <div class="card-body p-4">

                        <% if (typeof message !== 'undefined' && message) { %>
                        <div class="alert alert-success alert-dismissible fade show">
                            <%= message %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <% } %>

                        <form method="POST" action="/maintenance/add">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Facility</label>
                                <select name="facility" class="form-select" required>
                                    <option value="">Select facility</option>
                                    <option value="Badminton Hall (6 Courts)">Badminton Hall (6 Courts)</option>
                                    <option value="Swimming Pool">Swimming Pool</option>
                                    <option value="Football and Rugby Field">Football and Rugby Field</option>
                                    <option value="Competition Hall">Competition Hall</option>
                                    <option value="Table Tennis Hall (6 Tables)">Table Tennis Hall (6 Tables)</option>
                                    <option value="Multi-Purpose Hall">Multi-Purpose Hall</option>
                                    <option value="Tennis / Basketball / Futsal Court">Tennis / Basketball / Futsal Court</option>
                                    <option value="Martial Arts Room">Martial Arts Room</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Start Date</label>
                                <input type="date" name="startDate" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">End Date</label>
                                <input type="date" name="endDate" class="form-control" required>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Reason for Maintenance</label>
                                <textarea name="reason" class="form-control" rows="3"
                                          placeholder="e.g. Resurfacing of court floor" required></textarea>
                            </div>

                            <button type="submit" class="btn w-100 fw-bold text-white"
                                    style="background-color:#1a4d2e;">
                                <i class="bi bi-tools me-2"></i>Schedule Maintenance
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Existing Maintenance List -->
                <div class="card border-0 shadow-sm rounded-4 mt-4">
                    <div class="card-header text-white rounded-top-4" style="background-color:#1a4d2e;">
                        <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Scheduled Maintenance</h5>
                    </div>
                    <div class="card-body p-0">
                        <% if (maintenanceList.length === 0) { %>
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-tools fs-2 d-block mb-2"></i>
                            No maintenance scheduled
                        </div>
                        <% } else { %>
                        <table class="table table-hover mb-0">
                            <thead style="background-color:#f0f7f0;">
                                <tr>
                                    <th class="p-3">Facility</th>
                                    <th class="p-3">Start</th>
                                    <th class="p-3">End</th>
                                    <th class="p-3">Reason</th>
                                    <th class="p-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% maintenanceList.forEach(m => { %>
                                <tr>
                                    <td class="p-3 fw-semibold"><%= m.facility %></td>
                                    <td class="p-3"><%= m.startDate %></td>
                                    <td class="p-3"><%= m.endDate %></td>
                                    <td class="p-3 text-muted"><%= m.reason %></td>
                                    <td class="p-3">
                                        <form action="/maintenance/delete/<%= m.id %>" method="POST">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <footer class="py-4 text-white text-center mt-5" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>