<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Facility Availability & Search</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark mb-4 shadow-sm">
        <div class="container-fluid">
            <span class="navbar-brand mb-0 h1">
                <i class="bi bi-calendar-check-fill me-2 text-warning"></i>LaunchLab - RP Sports Complex
            </span>
            <span class="badge bg-primary px-3 py-2">Feature 4: Availability & Search Dashboard</span>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="card-title mb-0"><i class="bi bi-search me-2"></i>Search Availability</h5>
                    </div>
                    <div class="card-body">
                        <form id="searchForm" class="row g-3">
                            <div class="col-12">
                                <label for="searchFacility" class="form-label fw-bold">Select Facility</label>
                                <select id="searchFacility" class="form-select">
                                    <option value="">-- All Facilities --</option>
                                    <option value="Badminton Court 1">Badminton Court 1</option>
                                    <option value="Competition Hall">Competition Hall</option>
                                    <option value="Swimming Pool">Swimming Pool</option>
                                    <option value="Football Field">Football Field</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label for="searchDate" class="form-label fw-bold">Target Date</label>
                                <input type="date" id="searchDate" class="form-control">
                            </div>

                            <div class="col-12 d-grid gap-2 pt-2">
                                <button type="button" class="btn btn-primary" onclick="renderSlots()">
                                    <i class="bi bi-filter-left me-1"></i>Apply Search Filters
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="resetFilters()">
                                    Reset Layout
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-dark text-white py-3">
                        <h5 class="card-title mb-0"><i class="bi bi-table me-2"></i>Available Time Blocks Matrix</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="ps-3">Facility Name</th>
                                        <th scope="col">Date</th>
                                        <th scope="col">Time Window</th>
                                        <th scope="col">Status</th>
                                        <th scope="col" class="text-end pe-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="slotsTableBody">
                                    </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div> <div class="row mt-2">
            <div class="col-12 mb-5">
                <div class="card shadow-sm border-0 border-start border-primary border-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 text-primary fw-bold">
                            <i class="bi bi-shield-lock-fill me-2"></i>[Admin View Area] Allocate Open Hours Block
                        </h5>
                    </div>
                    <div class="card-body bg-white">
                        <form id="addSlotForm" class="row row-cols-md-auto g-3 align-items-end">
                            <div class="col-12">
                                <label for="newFacility" class="form-label fw-bold">Choose Target Facility</label>
                                <select id="newFacility" class="form-select">
                                    <option value="Badminton Court 1">Badminton Court 1</option>
                                    <option value="Competition Hall">Competition Hall</option>
                                    <option value="Swimming Pool">Swimming Pool</option>
                                    <option value="Football Field">Football Field</option>
                                </select>
                            </div>
                            
                            <div class="col-12">
                                <label for="newDate" class="form-label fw-bold">Calendar Date</label>
                                <input type="date" id="newDate" class="form-control" required>
                            </div>

                            <div class="col-12">
                                <label for="newTime" class="form-label fw-bold">Hours Window</label>
                                <input type="text" id="newTime" class="form-control" placeholder="e.g., 14:00 - 15:00" required>
                            </div>

                            <div class="col-12 ms-auto pt-2">
                                <button type="button" class="btn btn-success px-4" onclick="addNewSlot()">
                                    <i class="bi bi-plus-circle me-1"></i>Generate Slot Record
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>