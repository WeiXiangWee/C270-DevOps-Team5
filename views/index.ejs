<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .hero-section {
            background-image: url('https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=1600');
            background-size: cover;
            background-position: center;
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
        }
        .hero-overlay {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 80, 0, 0.65);
        }
        .hero-content {
            position: relative;
            z-index: 1;
        }
        .step-circle {
            width: 60px;
            height: 60px;
            background-color: #2d7a2d;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            color: white;
            font-size: 1.5rem;
            font-weight: bold;
        }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/navbar') %>

    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-overlay"></div>
        <div class="container hero-content text-white text-center">
            <h1 class="display-3 fw-bold mb-3">
                Book Your Sport.<br>Play Your Game.
            </h1>
            <p class="lead mb-4 fs-5">
                Reserve your favourite sports facilities at Republic Polytechnic<br>
                instantly and hassle-free.
            </p>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="py-5" style="background-color:#2d7a2d;">
        <div class="container">
            <div class="row g-4 text-white text-center">
                <div class="col-md-4">
                    <i class="bi bi-building fs-1 mb-2"></i>
                    <h2 class="fw-bold">6+</h2>
                    <p class="mb-0">Sports Facilities</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-clock fs-1 mb-2"></i>
                    <h2 class="fw-bold">9am - 9pm</h2>
                    <p class="mb-0">Mon - Fri</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-people fs-1 mb-2"></i>
                    <h2 class="fw-bold">Open To All</h2>
                    <p class="mb-0">Students, Staff & External</p>
                </div>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="py-5" style="background-color:#f0f7f0;">
        <div class="container">
            <h2 class="fw-bold text-center mb-5">
                How It <span style="color:#2d7a2d;">Works</span>
            </h2>
            <div class="row g-4 text-center">
                <div class="col-md-3">
                    <div class="step-circle">1</div>
                    <h5 class="fw-bold">Register</h5>
                    <p class="text-muted small">
                        Create your account as student, staff, 
                        alumni or external organisation
                    </p>
                </div>
                <div class="col-md-3">
                    <div class="step-circle">2</div>
                    <h5 class="fw-bold">Browse</h5>
                    <p class="text-muted small">
                        Find the facility you want and check 
                        real-time availability
                    </p>
                </div>
                <div class="col-md-3">
                    <div class="step-circle">3</div>
                    <h5 class="fw-bold">Book</h5>
                    <p class="text-muted small">
                        Select your date and time slot and 
                        confirm your booking instantly
                    </p>
                </div>
                <div class="col-md-3">
                    <div class="step-circle">4</div>
                    <h5 class="fw-bold">Play!</h5>
                    <p class="text-muted small">
                        Show your booking confirmation and 
                        enjoy your sports session
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="py-4 text-white text-center" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>