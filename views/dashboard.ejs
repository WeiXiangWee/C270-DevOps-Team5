<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .booking-banner {
            background-color: #2d7a2d;
            border-radius: 20px;
            padding: 50px;
            color: white;
            text-align: center;
        }
        .quick-link-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
            transition: transform 0.2s, box-shadow 0.2s;
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .quick-link-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            color: inherit;
        }
        .icon-circle {
            width: 60px;
            height: 60px;
            background-color: #e8f5e8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/navbar') %>

    <div class="container py-5">

        <!-- Book a Court Session Banner -->
        <div class="booking-banner mb-5">
            <h2 class="fw-bold mb-3">Book a Court Session</h2>
            <p class="mb-4">Reserve your favourite sports facility in just a few clicks</p>
            <a href="/bookings/add" class="btn btn-light fw-bold px-4 py-2">
                <i class="bi bi-plus-circle me-2"></i>Make a Booking
            </a>
        </div>

        <h4 class="fw-bold mb-4">Quick Actions</h4>
        <div class="row g-4">
            <div class="col-md-4">
                <a href="/facilities" class="quick-link-card card p-4">
                    <div class="icon-circle">
                        <i class="bi bi-building fs-3" style="color:#2d7a2d;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Browse Facilities</h5>
                    <p class="text-muted small mb-0">Explore all available RP sports facilities</p>
                </a>
            </div>

            <div class="col-md-4">
                <a href="/bookings" class="quick-link-card card p-4">
                    <div class="icon-circle">
                        <i class="bi bi-calendar-check fs-3" style="color:#2d7a2d;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">My Bookings</h5>
                    <p class="text-muted small mb-0">View, edit or cancel your upcoming reservations</p>
                </a>
            </div>

            <div class="col-md-4">
                <a href="/search" class="quick-link-card card p-4">
                    <div class="icon-circle">
                        <i class="bi bi-calendar-week fs-3" style="color:#2d7a2d;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Check Availability</h5>
                    <p class="text-muted small mb-0">Search and filter facilities by date, time and sport type</p>
                </a>
            </div>

            <% if (session.user.role === 'admin') { %>
            <div class="col-md-4">
                <a href="/facilities/add" class="quick-link-card card p-4">
                    <div class="icon-circle">
                        <i class="bi bi-building-add fs-3" style="color:#2d7a2d;"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Manage Facilities</h5>
                    <p class="text-muted small mb-0">Add, edit or remove RP sports facilities</p>
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <footer class="py-4 text-white text-center mt-5" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>