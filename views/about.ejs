<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .hero-about {
            background-color: #2d7a2d;
            padding: 80px 0;
            color: white;
        }
        .breadcrumb-nav {
            background-color: #f0f7f0;
            padding: 12px 0;
        }
        .breadcrumb-nav a {
            color: #2d7a2d;
            text-decoration: none;
        }
        .breadcrumb-nav a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/navbar') %>

    <!-- Breadcrumb -->
    
    <div class="breadcrumb-nav">
        <div class="container">
            <a href="/" class="text-decoration-none fw-semibold" style="color:#2d7a2d;">
                <i class="bi bi-arrow-left me-1"></i>Home
            </a>
        </div>
    </div>

    <!-- Hero Banner -->
    <div class="hero-about text-center">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">About RP Sports Complex</h1>
            <p class="lead mb-0">Discover Your Sport, Shape Your Future</p>
        </div>
    </div>

    <!-- Our Story -->
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <h2 class="fw-bold mb-3">
                    Our <span style="color:#2d7a2d;">Story</span>
                </h2>
                <p class="text-muted fs-5">
                    Established as part of Republic Polytechnic's School of 
                    Sports and Health, the RP Sports Complex was built to 
                    nurture students who are not just academically excellent, 
                    but physically resilient and community-minded. Our 
                    world-class facilities meet international standards from 
                    organisations like FIBA and FIFA, giving every student, 
                    staff member, and visitor the space to discover their 
                    sport and shape their future.
                </p>
            </div>
        </div>
    </div>

    <!-- Our Mission -->
    <div class="py-5" style="background-color:#f0f7f0;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                        <i class="bi bi-bullseye fs-1 mb-3" style="color:#2d7a2d;"></i>
                        <h3 class="fw-bold mb-3">Our Mission</h3>
                        <p class="text-muted fs-5 mb-0">
                            To empower the RP community and beyond to become 
                            active, resilient individuals through accessible 
                            and convenient sports facilities — because we 
                            believe physical wellbeing is just as important 
                            as academic excellence.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="py-4 text-white text-center" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>