<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .hero-contact {
            background-color: #2d7a2d;
            padding: 60px 0;
            color: white;
        }
        .contact-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        }
        .icon-circle {
            width: 55px;
            height: 55px;
            background-color: #e8f5e8;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
    </style>
</head>
<body class="bg-light">

    <!-- Only show navbar for PUBLIC (not logged in) -->
    <% if (!locals.session || !locals.session.user) { %>
        <%- include('partials/navbar') %>
    <% } %>

    <!-- Back Button -->
    <div style="background-color:#f0f7f0; padding: 12px 0; border-bottom: 0.5px solid #cce5d6;">
        <div class="container">
            <a href="<%= locals.session && locals.session.user ? '/dashboard' : '/' %>"
               class="text-decoration-none fw-semibold" style="color:#2d7a2d;">
                <i class="bi bi-arrow-left me-1"></i>
                <%= locals.session && locals.session.user ? 'Back to Dashboard' : 'Back to Home' %>
            </a>
        </div>
    </div>

    <!-- Hero Banner -->
    <div class="hero-contact text-center">
        <div class="container">
            <h1 class="display-5 fw-bold mb-2">Contact Us</h1>
            <p class="lead mb-0">We're here to help you with your sports facility bookings</p>
        </div>
    </div>

    <div class="container py-5">
        <div class="row g-4">

            <!-- Phone -->
            <div class="col-md-6">
                <div class="card contact-card p-4 h-100">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-circle">
                            <i class="bi bi-telephone-fill fs-4" style="color:#2d7a2d;"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Phone</h5>
                    </div>
                    <p class="text-muted mb-1">Sports Complex Bookings:</p>
                    <p class="fw-bold fs-5 mb-0">6369 8900</p>
                </div>
            </div>

            <!-- Email -->
            <div class="col-md-6">
                <div class="card contact-card p-4 h-100">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-circle">
                            <i class="bi bi-envelope-fill fs-4" style="color:#2d7a2d;"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Email</h5>
                    </div>
                    <p class="text-muted mb-1">General Enquiries:</p>
                    <p class="fw-bold fs-5 mb-0">help-OCC@rp.edu.sg</p>
                </div>
            </div>

            <!-- Address -->
            <div class="col-md-6">
                <div class="card contact-card p-4 h-100">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-circle">
                            <i class="bi bi-geo-alt-fill fs-4" style="color:#2d7a2d;"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Address</h5>
                    </div>
                    <p class="text-muted mb-1">Republic Polytechnic</p>
                    <p class="fw-bold mb-0">9 Woodlands Avenue 9</p>
                    <p class="fw-bold mb-0">Singapore 738964</p>
                </div>
            </div>

            <!-- Operating Hours -->
            <div class="col-md-6">
                <div class="card contact-card p-4 h-100">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-circle">
                            <i class="bi bi-clock-fill fs-4" style="color:#2d7a2d;"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Operating Hours</h5>
                    </div>
                    <table class="table table-borderless mb-0 small">
                        <tr>
                            <td class="fw-semibold ps-0">Monday - Friday</td>
                            <td class="text-end">
                                <span class="badge bg-success">9am - 9pm</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-semibold ps-0">Saturday</td>
                            <td class="text-end">
                                <span class="badge bg-success">9am - 1pm</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-semibold ps-0">Sunday</td>
                            <td class="text-end">
                                <span class="badge bg-danger">Closed</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-semibold ps-0">Public Holidays</td>
                            <td class="text-end">
                                <span class="badge bg-danger">Closed</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Google Maps -->
            <div class="col-12">
                <div class="card contact-card p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="icon-circle">
                            <i class="bi bi-map-fill fs-4" style="color:#2d7a2d;"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Find Us</h5>
                    </div>
                    <div class="ratio ratio-16x9 rounded-3 overflow-hidden">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.494908!2d103.7649!3d1.4390!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31da13a0974cdb07%3A0x9c5b3a5c4c3f4b3a!2sRepublic%20Polytechnic!5e0!3m2!1sen!2ssg!4v1234567890"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy">
                        </iframe>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <footer class="py-4 text-white text-center" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>