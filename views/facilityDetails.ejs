<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facilities - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .facility-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
            transition: transform 0.2s;
            cursor: pointer;
            overflow: hidden;
        }
        .facility-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        .facility-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }
        .category-badge {
            background-color: #e8f5e8;
            color: #2d7a2d;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
        }
        .modal-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 12px;
        }
        .detail-row {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid #f3f4f6;
        }
        .detail-row:last-child { border-bottom: none; }
        .detail-icon {
            width: 36px;
            height: 36px;
            background-color: #e8f5e8;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/navbarSimple') %>

    <div class="container py-5">
        <a href="/dashboard" class="text-decoration-none fw-semibold mb-3 d-inline-block" style="color:#2d7a2d;">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>

        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <h2 class="fw-bold mb-0">Sports Facilities</h2>
            <% if (session.user && session.user.role === 'admin') { %>
            <a href="/facilities/add" class="btn fw-bold text-white" style="background-color:#2d7a2d;">
                <i class="bi bi-plus-circle me-2"></i>Add Facility
            </a>
            <% } %>
        </div>

        <div class="row g-4">
            <% facilities.forEach(facility => { %>
            <div class="col-md-4">
                <div class="card facility-card"
                     data-name="<%= facility.name %>"
                     data-category="<%= facility.category %>"
                     data-capacity="<%= facility.capacity %>"
                     data-image="<%= facility.image %>"
                     data-description="<%= facility.description %>"
                     data-location="<%= facility.location %>"
                     data-equipment="<%= facility.equipment %>"
                     onclick="showModal(this)">
                    <img src="<%= facility.image %>" alt="<%= facility.name %>"
                         onerror="this.src='https://via.placeholder.com/600x180'">
                    <div class="card-body p-3">
                        <span class="category-badge mb-2 d-inline-block"><%= facility.category %></span>
                        <h5 class="fw-bold mt-2 mb-0"><%= facility.name %></h5>
                    </div>

                    <% if (session.user && session.user.role === 'admin') { %>
                    <div class="card-footer bg-white border-0 p-3 pt-0"
                         onclick="event.stopPropagation()">
                        <div class="d-flex gap-2">
                            <a href="/facilities/edit/<%= facility.id %>"
                               class="btn btn-sm flex-grow-1 btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="showDeleteModal(<%= facility.id %>, '<%= facility.name %>')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </div>
    </div>

    <!-- Facility Details Modal -->
    <div class="modal fade" id="facilityModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content border-0 rounded-4">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <img id="modalImg" src="" alt="" class="modal-img mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span id="modalCategory" class="badge px-3 py-2"
                              style="background-color:#e8f5e8; color:#2d7a2d; font-size:0.85rem;"></span>
                    </div>
                    <h4 id="modalName" class="fw-bold mb-4"></h4>

                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-card-text" style="color:#2d7a2d;"></i>
                        </div>
                        <div>
                            <small class="text-muted fw-semibold d-block mb-1">DESCRIPTION</small>
                            <p id="modalDescription" class="mb-0"></p>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-geo-alt" style="color:#2d7a2d;"></i>
                        </div>
                        <div>
                            <small class="text-muted fw-semibold d-block mb-1">LOCATION</small>
                            <p id="modalLocation" class="mb-0 fw-semibold"></p>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-box-seam" style="color:#2d7a2d;"></i>
                        </div>
                        <div>
                            <small class="text-muted fw-semibold d-block mb-1">EQUIPMENT PROVIDED</small>
                            <p id="modalEquipment" class="mb-0"></p>
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-icon">
                            <i class="bi bi-people" style="color:#2d7a2d;"></i>
                        </div>
                        <div>
                            <small class="text-muted fw-semibold d-block mb-1">MAX CAPACITY</small>
                            <p id="modalCapacity" class="mb-0 fw-semibold"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Facility Modal -->
    <% if (session.user && session.user.role === 'admin') { %>
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content rounded-4 border-0">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Delete Facility
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Warning!</strong> This is a dangerous action
                        and cannot be undone!
                    </div>
                    <p>Are you sure you want to delete
                       <strong id="deleteFacilityName"></strong>?</p>
                    <p class="text-muted small">
                        This facility will be permanently removed from the system.
                    </p>
                    <form id="deleteForm" method="POST">
                        <div class="d-flex gap-2 justify-content-end mt-3">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                <i class="bi bi-x me-1"></i>Cancel
                            </button>
                            <button type="submit" class="btn btn-danger fw-bold">
                                <i class="bi bi-trash me-1"></i>Yes, Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <footer class="py-4 text-white text-center mt-5" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function showModal(card) {
            const name = card.dataset.name;
            const category = card.dataset.category;
            const capacity = card.dataset.capacity;
            const image = card.dataset.image;
            const description = card.dataset.description;
            const location = card.dataset.location;
            const equipment = card.dataset.equipment;

            document.getElementById('modalName').textContent = name;
            document.getElementById('modalCategory').textContent = category;
            document.getElementById('modalCapacity').textContent = capacity + ' persons';
            document.getElementById('modalImg').src = image;
            document.getElementById('modalImg').alt = name;
            document.getElementById('modalDescription').textContent = description;
            document.getElementById('modalLocation').textContent = location;
            document.getElementById('modalEquipment').textContent = equipment;

            const modal = new bootstrap.Modal(document.getElementById('facilityModal'));
            modal.show();
        }

        function showDeleteModal(facilityId, facilityName) {
            document.getElementById('deleteFacilityName').textContent = facilityName;
            document.getElementById('deleteForm').action = '/facilities/delete/' + facilityId;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
</body>
</html>