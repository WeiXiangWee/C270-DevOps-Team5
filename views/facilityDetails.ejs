<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facilities - RP Sports Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .facility-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
            transition: transform 0.2s;
        }
        .facility-card:hover {
            transform: translateY(-5px);
        }
        .category-badge {
            background-color: #e8f5e8;
            color: #2d7a2d;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
        }
    </style>
</head>
<body class="bg-light">

    <%- include('partials/navbarSimple') %>

    <div class="container py-5">
        <a href="/dashboard" class="text-decoration-none fw-semibold mb-3 d-inline-block" style="color:#2d7a2d;">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>

        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <h2 class="fw-bold mb-0">Sports Facilities</h2>
            <% if (session.user && session.user.role === 'admin') { %>
            <a href="/facilities/add" class="btn fw-bold text-white" style="background-color:#2d7a2d;">
                <i class="bi bi-plus-circle me-2"></i>Add Facility
            </a>
            <% } %>
        </div>

        <div class="row g-4">
            <% facilities.forEach(facility => { %>
            <div class="col-md-4">
                <div class="card facility-card p-3">
                    <span class="category-badge mb-2" style="width:fit-content;"><%= facility.category %></span>
                    <h5 class="fw-bold mt-2"><%= facility.name %></h5>
                    <p class="text-muted mb-3">
                        <i class="bi bi-people me-1"></i>Max capacity: <%= facility.capacity %>
                    </p>

                    <% if (session.user && session.user.role === 'admin') { %>
                    <div class="d-flex gap-2">
                        <a href="/facilities/edit/<%= facility.id %>" class="btn btn-sm flex-grow-1 btn-outline-secondary">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <form action="/facilities/delete/<%= facility.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </div>
    </div>

    <footer class="py-4 text-white text-center mt-5" style="background-color:#2d7a2d;">
        <p class="mb-0">© 2026 RP Sports Booking System | Republic Polytechnic</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>